# Copie para .env.local e preencha (Supabase → Project Settings → API).
# Sem estas variáveis o app roda em modo demo (dados só neste navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Anti-robô do login (Cloudflare Turnstile): chave do SITE (pública). A chave secreta vai só no
# Supabase → Authentication → Attack Protection. Vazio = sem captcha.
VITE_TURNSTILE_SITEKEY=
